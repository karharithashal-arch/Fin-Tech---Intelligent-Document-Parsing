import json

with open("annotations.json", "r", encoding="utf-8") as f:
    data = json.load(f)

text = data["text"]
entities = [(start, end, label) for start, end, label in data["label"]]

TRAIN_DATA = [(text, {"entities": entities})]

print("Converted successfully!")
print(TRAIN_DATA)


